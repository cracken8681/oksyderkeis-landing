        ["q7", "Από πού έρχονται σήμερα οι καλύτεροι πελάτες σας;", "Επιλέξτε όσα ισχύουν", "multi", 0, ["Συστάσεις από ανθρώπους που σας ξέρουν", "Google αναζήτηση", "Social / LinkedIn", "Σεμινάρια / events", "Υπάρχοντες πελάτες που ξαναγοράζουν"], true],
        ["q8", "Πόσοι νέοι ενδιαφερόμενοι πελάτες (κλήσεις, μηνύματα, φόρμες) σας έρχονται περίπου τον μήνα;", "Χονδρική εκτίμηση αρκεί - είναι το σημείο εκκίνησης της μέτρησης.", "single", 0, ["0-2", "3-10", "11-30", "Πάνω από 30", "Δεν το μετράμε ακόμα"], false],
        ["q9", "Σε ποια από αυτά έχετε πρόσβαση;", "Επιλέξτε όσα ισχύουν", "multi", 0, ["Google Analytics (το εργαλείο που μετράει τις επισκέψεις στο site)", "Google Search Console (δείχνει με ποιες αναζητήσεις σας βρίσκουν στο Google)", "Google Business Profile (η καταχώρησή σας στον χάρτη της Google, με τις κριτικές)", "Στατιστικά από την πλατφόρμα του site σας (π.χ. WordPress, Wix, Shopify)", "Τίποτα από αυτά", "Δεν ξέρω"], false],
        ["q10", "Τι έχετε δοκιμάσει μέχρι τώρα για να φέρετε πελάτες online;", "Επιλέξτε όσα ισχύουν", "multi", 0, ["Βελτιώσεις για να βγαίνετε πιο ψηλά στο Google (SEO ή εταιρεία προώθησης)", "Πληρωμένες διαφημίσεις Google (Google Ads)", "Αναρτήσεις σε social media χωρίς πληρωμένη διαφήμιση", "Ενημερωτικά email (newsletter)", "Τίποτα οργανωμένο μέχρι τώρα"], true],
        ["q11", "Πού πιστεύετε ότι χάνεται ο επισκέπτης στο site σας;", "Αν δεν το ξέρετε, κανένα πρόβλημα - το εντοπίζει ο έλεγχος.", "single", 0, ["Η υπηρεσία αργεί να γίνει ξεκάθαρη", "Το επόμενο κουμπί δεν φαίνεται καθαρά", "Βλέπει πολλές επιλογές και μπερδεύεται", "Λείπει ένας δυνατός λόγος να επικοινωνήσει", "Δεν έχω δεδομένα / δεν ξέρω"], true]
      ]},
      { key: "Ε", title: "Αποδείξεις & ανταγωνισμός", why: "Γιατί: οι αποδείξεις εμπιστοσύνης καθορίζουν τι θα δείξουμε· ο ανταγωνισμός δείχνει με ποιους σας συγκρίνει ο πελάτης.", questions: [
        ["q12", "Ποια είναι η πιο δυνατή σας απόδειξη ότι κάνετε καλή δουλειά;", "Επιλέξτε έως 2", "multi", 2, ["Κριτικές / Google reviews", "Παραδείγματα έργων με αποτελέσματα", "Χρόνια εμπειρίας", "Γνωστές συνεργασίες / πελάτες", "Πιστοποιήσεις / μέθοδος"], true],
        ["q13", "Ποιον θεωρείτε άμεσο ανταγωνιστή ή εναλλακτική λύση;", "Αν δεν έχετε όνομα, γράψτε τι θα έψαχνε ο πελάτης αντί για εσάς.", "single", 0, ["Άλλη εταιρεία συμβούλων / γραφείο", "Εταιρεία εύρεσης προσωπικού", "Ανεξάρτητος επαγγελματίας / coach", "Το κάνουν μόνοι τους μέσα στην επιχείρηση", "Δεν γνωρίζω"], true],
        ["q14", "Σε ποια αναζήτηση θα θέλατε να σας βρίσκει ο ιδανικός πελάτης;", "Παράδειγμα: αξιολόγηση προσωπικού Ελλάδα, λογιστής για e-shop Αθήνα.", "single", 0, ["Υπηρεσία + περιοχή", "Το πρόβλημα που έχει ο πελάτης", "Το όνομα της επιχείρησής μου", "Δεν είμαι σίγουρος/η"], true]
      ]},
      { key: "ΣΤ", title: "Στόχοι & υλοποίηση", why: "Γιατί: για να ξέρουμε πώς μετράμε την επιτυχία και ποιος μπορεί να εφαρμόσει τις αλλαγές.", questions: [
        ["q15", "Τι θα θεωρούσατε επιτυχία σε 30-60 μέρες;", "", "single", 0, ["Περισσότερα τηλεφωνικά ραντεβού", "Περισσότερες φόρμες / ενδιαφερόμενοι πελάτες", "Πιο ξεκάθαρο site που εξηγεί τι κάνουμε", "Καλύτερη εμφάνιση σε Google / AI αναζητήσεις", "Καλύτερη σελίδα για μία συγκεκριμένη υπηρεσία"], true],
        ["q16", "Ποιος κάνει σήμερα αλλαγές στο site σας;", "Καθορίζει πόσο γρήγορα μπορούν να εφαρμοστούν οι προτάσεις.", "single", 0, ["Εγώ ο ίδιος / η ίδια", "Συνεργάτης / τεχνικός (developer)", "Εξωτερική εταιρεία", "Κανείς αυτή τη στιγμή", "Δεν ξέρω"], true],
        ["q17", "Πόσο άμεσα θέλετε την πρώτη βελτίωση;", "", "single", 0, ["Αυτή την εβδομάδα", "Μέσα στον μήνα", "Στο επόμενο δίμηνο", "Θέλω πρώτα να δω το πλάνο"], false],
        ["q18", "Υπάρχει κάτι που δεν θέλετε να αλλάξει ή κάτι που πρέπει να ξέρουμε;", "Επιλέξτε όσα ισχύουν ή γράψτε ελεύθερα", "multi", 0, ["Το ύφος / τόνος επικοινωνίας", "Οι βασικές υπηρεσίες", "Τα χρώματα / brand", "Υπάρχει συγκεκριμένο διαθέσιμο budget", "Έχω ήδη συνεργάτη για κάποια κομμάτια", "Κανένας περιορισμός"], false]
      ]}
    ];

    const TOTAL = 18;
    const state = {};
    const sessionId = getSessionId();
    let quizStartTracked = false;
    const sectionsRoot = document.getElementById("sections");

    trackEvent("page_view");

    QUESTION_SECTIONS.forEach((section) => {
      const sectionEl = document.createElement("div");
      sectionEl.className = "section";
      sectionEl.innerHTML = `<div class="stag"><span class="snum">${section.key}</span><span class="stitle">${escapeHtml(section.title)}</span></div><div class="swhy">${escapeHtml(section.why)}</div>`;
      section.questions.forEach((q, index) => sectionEl.appendChild(questionCard(q, index)));
      sectionsRoot.appendChild(sectionEl);
    });

    function questionCard(q) {
      const [id, title, hint, type, max, options, hasOther] = q;
      state[id] = { choices: [], other: "" };
      const card = document.createElement("div");
      card.className = "q";
      card.dataset.q = id;
      card.innerHTML = `
        <div class="qhead"><span class="qn">${id.replace("q", "")}.</span><span class="qt">${escapeHtml(title)}</span></div>
        ${hint ? `<div class="${type === "multi" ? "multi-note" : "qhint"}">${escapeHtml(hint)}</div>` : ""}
        <div class="opts" data-type="${type}" data-max="${max || 0}"></div>
        <div class="otherwrap ${id === "q18" ? "show" : ""}">${id === "q18" ? '<textarea placeholder="Οτιδήποτε δεν χωρά στις επιλογές - περιορισμοί, ιδιαιτερότητες, στόχοι..."></textarea>' : '<input type="text" placeholder="Γράψτε τη δική σας απάντηση...">'}</div>
      `;
      const wrap = card.querySelector(".opts");
      options.forEach((label) => wrap.appendChild(optionButton(id, card, label, type, max)));
      if (hasOther) wrap.appendChild(optionButton(id, card, "Άλλο", type, max, true));
      const otherInput = card.querySelector(".otherwrap input, .otherwrap textarea");
      if (otherInput) otherInput.addEventListener("input", (event) => { state[id].other = event.target.value.trim(); progress(); });
      return card;
    }

    function optionButton(qid, card, label, type, max, isOther) {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "opt";
      b.textContent = isOther ? "Άλλο..." : label;
      b.addEventListener("click", () => toggle(qid, card, b, label, type, max, isOther));
      return b;
    }

    function toggle(qid, card, btn, label, type, max, isOther) {
      trackQuizStart();
      const s = state[qid];
      if (type === "single") {
        card.querySelectorAll(".opt").forEach((o) => o.classList.remove("sel"));
        btn.classList.add("sel");
        s.choices = [label];
        if (!isOther) card.querySelector(".otherwrap")?.classList.remove("show");
      } else if (btn.classList.contains("sel")) {
        btn.classList.remove("sel");
        s.choices = s.choices.filter((c) => c !== label);
      } else {
        if (max && s.choices.length >= max) return;
        btn.classList.add("sel");
        s.choices.push(label);
      }
      if (isOther) {
        const other = card.querySelector(".otherwrap");
        other.classList.toggle("show", btn.classList.contains("sel"));
        if (btn.classList.contains("sel")) other.querySelector("input, textarea")?.focus();
      }
      card.classList.toggle("answered", s.choices.length > 0 || !!s.other);
      progress();
    }

    function progress() {
      const done = Object.values(state).filter((s) => s.choices.length > 0 || s.other).length;
      document.getElementById("pfill").style.width = (done / TOTAL * 100) + "%";
      document.getElementById("plabel").textContent = done + " / " + TOTAL;
    }

    document.getElementById("quizForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      const err = document.getElementById("formerr");
      err.classList.remove("show");
      if (document.querySelector(".honey").value) return;

      const contact = {
        business: v("c_business"),
        website: v("c_website"),
        name: v("c_name"),
        role: v("c_role"),
        email: v("c_email"),
        emailConfirm: v("c_email_confirm"),
        phone: v("c_phone"),
        industry: v("c_industry")
      };
      let bad = false;
      [["c_business", contact.business], ["c_website", contact.website], ["c_name", contact.name], ["c_email", contact.email], ["c_email_confirm", contact.emailConfirm]].forEach(([id, val]) => {
        const el = document.getElementById(id);
        const ok = id.startsWith("c_email") ? /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val) : !!val;
        el.classList.toggle("err", !ok);
        if (!ok) bad = true;
      });
      const emailMismatch = normalizeEmail(contact.email) !== normalizeEmail(contact.emailConfirm);
      document.getElementById("c_email").classList.toggle("err", bad || emailMismatch);
      document.getElementById("c_email_confirm").classList.toggle("err", bad || emailMismatch);
      const consent = document.getElementById("consent").checked;
      document.getElementById("consentbox").classList.toggle("err", !consent);
      const answered = Object.values(state).filter((s) => s.choices.length > 0 || s.other).length;
      if (bad || emailMismatch || !consent || answered < 10) {
        err.textContent = !consent ? "Χρειάζεται η συγκατάθεση για να προχωρήσουμε." : bad ? "Συμπληρώστε τα υποχρεωτικά στοιχεία (επιχείρηση, website, όνομα, email και επιβεβαίωση email)." : emailMismatch ? "Τα δύο email δεν ταιριάζουν. Ελέγξτε τα πριν στείλετε τη φόρμα." : "Απαντήστε τουλάχιστον 10 ερωτήσεις για να έχει αξία το διαγνωστικό (" + answered + "/10).";
        err.classList.add("show");
        err.scrollIntoView({ block: "center" });
        return;
      }
      const visibilityScore = calculateVisibilityScore(contact);
      delete contact.emailConfirm;

      const payload = {
        meta: {
          source: CONFIG.source,
          version: "v2",
          visibility_score: visibilityScore.total,
          visibility_score_label: visibilityScore.label,
          submitted_at: new Date().toISOString(),
          lang: "el",
          session_id: sessionId,
          path: location.pathname,
          referrer: document.referrer || ""
        },
        contact,
        consent: true,
        answers: Object.fromEntries(Object.entries(state).map(([k, s]) => [k, { choices: s.choices, other: s.other }]))
      };

      const btn = document.getElementById("submitbtn");
      btn.disabled = true;
      btn.textContent = "Αποστολή...";
      let sent = false;
      if (CONFIG.endpoint) {
        try {
          const response = await fetch(CONFIG.endpoint, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
          if (!response.ok) {
            let result = {};
            try { result = await response.json(); } catch (_) {}
            throw new Error(result.error || "submit_failed_" + response.status);
          }
          sent = true;
          trackEvent("submit_success");
        } catch (ex) {
          console.error("submit failed", ex);
          btn.disabled = false;
          btn.textContent = "Στείλτε το διαγνωστικό";
          err.textContent = ex.message === "email_domain_unverified" ? "Δεν μπορέσαμε να επιβεβαιώσουμε το domain του email. Ελέγξτε μήπως υπάρχει typo ή βάλτε άλλο email." : "Δεν στάλθηκε η φόρμα. Δοκιμάστε ξανά ή στείλτε μας email στο oksyderkeisbydavid@gmail.com.";
          err.classList.add("show");
          err.scrollIntoView({ block: "center" });
          return;
        }
      }
      document.getElementById("quizForm").style.display = "none";
      document.querySelector(".progress").style.display = "none";
      document.getElementById("success").classList.add("show");
      showInstantScore(visibilityScore);
      if (!CONFIG.endpoint) {
        const json = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
        const flat = [["field", "value"], ...Object.entries(contact).map(([k, val]) => [k, val]), ...Object.entries(payload.answers).map(([k, a]) => [k, [...a.choices, a.other].filter(Boolean).join(" | ")])];
        const csv = new Blob(["\uFEFF" + flat.map((r) => r.map((c) => '"' + String(c).replace(/"/g, '""') + '"').join(",")).join("\n")], { type: "text/csv" });
        document.getElementById("demodl").innerHTML = 'Λειτουργία δοκιμής: <a download="intake.json" href="' + URL.createObjectURL(json) + '">JSON</a>·<a download="intake.csv" href="' + URL.createObjectURL(csv) + '">CSV</a>';
      } else if (!sent) {
        document.getElementById("demodl").textContent = "Σημείωση: το αίτημα καταγράφηκε τοπικά - αν δεν λάβετε email επιβεβαίωσης, στείλτε μας μήνυμα.";
      }
      window.scrollTo({ top: 0 });
    });

    function v(id) { return document.getElementById(id).value.trim(); }
    function normalizeEmail(value) { return String(value || "").trim().toLowerCase(); }
    function selected(qid) {
      const answer = state[qid] || {};
      return [...(answer.choices || []), answer.other || ""].filter(Boolean).join(" | ");
    }
    function includesAnswer(qid, terms) {
      const text = selected(qid).toLowerCase();
      return terms.some((term) => text.includes(term.toLowerCase()));
    }
    function calculateVisibilityScore(contact) {
      let score = 35;
      const checks = [];

      const websiteLooksUsable = /^https?:\/\/[^.\s]+\.[^\s]+/.test(contact.website);
      if (websiteLooksUsable) score += 8;
      checks.push(websiteLooksUsable ? "Το website δόθηκε σε καθαρή μορφή." : "Το website θέλει επιβεβαίωση πριν τον έλεγχο.");

      const hasDemandSignal = selected("q8").length > 0 && !includesAnswer("q8", ["0-2", "Δεν το μετράμε"]);
      if (hasDemandSignal) score += 12;
      checks.push(hasDemandSignal ? "Υπάρχει ήδη ζήτηση για να συγκριθεί μετά." : "Η ζήτηση ή η μέτρηση αιτημάτων επικοινωνίας φαίνεται αδύναμη.");

      const hasMeasurementAccess = includesAnswer("q9", ["Analytics", "Search Console", "Business Profile", "Στατιστικά"]);
      if (hasMeasurementAccess) score += 14;
      checks.push(hasMeasurementAccess ? "Υπάρχουν στοιχεία μέτρησης για πιο καθαρή πρώτη εικόνα." : "Λείπουν βασικά στοιχεία μέτρησης για πριν/μετά.");

      const hasTrustProof = selected("q12").length > 0;
      if (hasTrustProof) score += 13;
      checks.push(hasTrustProof ? "Υπάρχουν αποδείξεις εμπιστοσύνης για αξιοποίηση." : "Οι αποδείξεις εμπιστοσύνης θέλουν χτίσιμο.");

      const hasSearchIntent = !includesAnswer("q14", ["Δεν είμαι σίγουρος"]) && selected("q14").length > 0;
      if (hasSearchIntent) score += 10;
      checks.push(hasSearchIntent ? "Υπάρχουν αρχικές ερωτήσεις πελατών για έλεγχο ορατότητας σε AI." : "Χρειάζεται να οριστεί τι ψάχνει ο πελάτης.");

      const knowsConversionAction = selected("q6").length > 0;
      if (knowsConversionAction) score += 8;
      checks.push(knowsConversionAction ? "Η πρώτη ενέργεια του επισκέπτη είναι σχετικά καθαρή." : "Το βασικό επόμενο βήμα προς επικοινωνία θέλει απόφαση.");

      score = Math.max(0, Math.min(100, score));
      const label = score >= 76 ? "Καλή βάση για ανάπτυξη" : score >= 56 ? "Υπάρχει ορατή ευκαιρία" : "Χρειάζεται πρώτα καθαρή πρώτη μέτρηση";
      return { total: score, label, checks };
    }
    function showInstantScore(result) {
      const box = document.getElementById("instantScore");
      if (!box) return;
      box.innerHTML = `
        <strong>Ενδεικτική βαθμολογία ορατότητας σε AI</strong>
        <span class="score">${result.total} / 100</span>
        <p class="muted">${escapeHtml(result.label)}. Αυτό δεν είναι τελικό AI Visibility Audit· είναι γρήγορη ένδειξη από τις απαντήσεις σας, πριν τρέξουμε πραγματικές αναζητήσεις και στιγμιότυπα οθόνης.</p>
        <ul>${result.checks.slice(0, 4).map((item) => `<li>${escapeHtml(item)}</li>`).join("")}</ul>
      `;
      box.classList.add("show");
    }
    function getSessionId() {
      const key = "ai_revenue_intake_session_id";
      const fallback = () => "s_" + Date.now().toString(36) + "_" + Math.random().toString(36).slice(2, 10);
      try {
        let id = sessionStorage.getItem(key);
        if (!id) {
          id = fallback();
          sessionStorage.setItem(key, id);
        }
        return id;
      } catch (_) {
        return fallback();
      }
    }
    function trackQuizStart() {
      if (quizStartTracked) return;
      quizStartTracked = true;
      trackEvent("quiz_start");
    }
    function trackEvent(eventName) {
      if (!CONFIG.analyticsEndpoint) return;
      const payload = {
        event: eventName,
        source: CONFIG.source,
        sessionId,
        path: location.pathname,
        referrer: document.referrer || "",
        pageVersion: "v2"
      };
      fetch(CONFIG.analyticsEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
        keepalive: true
      }).catch(() => {});
    }
    function escapeHtml(text) {
      return String(text).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;");
    }
  </script>
</body>
</html>
