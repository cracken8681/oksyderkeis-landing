---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config";

const quizUrl = "/ai-revenue";
const pageUrl = `${SITE.url}/ai-audit`;

const faqItems = [
  {
    question: "Τι είναι AI Visibility Audit;",
    answer:
      "Είναι έλεγχος του πώς εμφανίζεται και πώς καταλαβαίνεται η επιχείρησή σου από ανθρώπους, Google και εργαλεία AI όπως ChatGPT ή Perplexity.",
  },
  {
    question: "Είναι SEO ή κάτι διαφορετικό;",
    answer:
      "Πατάει πάνω σε SEO, αλλά κοιτά και τις απαντήσεις που δίνουν τα εργαλεία AI: αν το περιεχόμενο, η δομή, οι αποδείξεις και οι σελίδες σου βοηθούν μια μηχανή να εξηγήσει σωστά ποιος είσαι και γιατί να σε προτείνει.",
  },
  {
    question: "Για ποιον είναι;",
    answer:
      "Για επαγγελματίες υπηρεσιών, τοπικές επιχειρήσεις και B2B ομάδες στην Ελλάδα που έχουν site αλλά δεν είναι σίγουροι αν φέρνει εμπιστοσύνη, αιτήματα επικοινωνίας και σωστή παρουσία σε Google και AI.",
  },
  {
    question: "Τι παίρνω μετά το ερωτηματολόγιο;",
    answer:
      "Το ερωτηματολόγιο δίνει την αρχική εικόνα. Αν υπάρχει πραγματικό κενό ορατότητας ή επικοινωνίας, προτείνεται πληρωμένος έλεγχος με συγκεκριμένο πλαίσιο και επόμενο βήμα.",
  },
  {
    question: "Τι περιλαμβάνει ο πληρωμένος έλεγχος;",
    answer:
      "Περιλαμβάνει έλεγχο site, μηνύματος, ορατότητας σε Google και AI, αποδείξεων εμπιστοσύνης, διαδρομής προς την επικοινωνία και προτεραιοτήτων. Η εγγύηση είναι τουλάχιστον 3 χρήσιμα ευρήματα ή επιστροφή χρημάτων.",
  },
  {
    question: "Τι δεν υποσχόμαστε;",
    answer:
      "Δεν υποσχόμαστε κατάταξη, έσοδα ή σίγουρα αποτελέσματα. Δείχνουμε τι βλέπουμε, τι λείπει και ποιες αλλαγές έχουν προτεραιότητα.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "AI Visibility Audit για επιχειρήσεις στην Ελλάδα",
    serviceType: "AI Visibility Audit",
    provider: {
      "@type": "Organization",
      name: "Oksyderkeis",
      url: SITE.url,
    },
    areaServed: ["Greece", "Cyprus", "European Union"],
    url: pageUrl,
    description:
      "Έλεγχος ορατότητας σε Google και AI για επιχειρήσεις στην Ελλάδα που θέλουν πιο καθαρό site, καλύτερη εμπιστοσύνη και σαφέστερο επόμενο βήμα.",
    offers: [
      {
        "@type": "Offer",
        name: "AI Visibility Audit",
        price: "349",
        priceCurrency: "EUR",
        url: quizUrl,
      },
      {
        "@type": "Offer",
        name: "Implementation Sprint",
        price: "1290",
        priceCurrency: "EUR",
        url: quizUrl,
      },
      {
        "@type": "Offer",
        name: "AI Visibility Monitoring",
        price: "250",
        priceCurrency: "EUR",
        description: "Μηνιαία παρακολούθηση ορατότητας, αναφορά και προτεραιότητες.",
        url: quizUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Base
  title="AI Visibility Audit για επιχειρήσεις στην Ελλάδα | Oksyderkeis"
  description="Έλεγχος ορατότητας σε Google και AI για επιχειρήσεις στην Ελλάδα που θέλουν καθαρό site, εμπιστοσύνη και περισσότερα σωστά αιτήματα."
  jsonLd={jsonLd}
>
  <main class="audit-page">
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">AI Revenue by Oksyderkeis</p>
          <h1>AI Visibility Audit για ελληνικές επιχειρήσεις που θέλουν να εμφανίζονται σωστά σε Google και AI απαντήσεις</h1>
          <p class="subtitle">
            Ελέγχουμε τι βλέπει ο πελάτης, τι διαβάζουν τα εργαλεία AI από πίσω και πού χάνεται η διαδρομή προς την επικοινωνία.
          </p>
          <div class="hero-actions">
            <a href={quizUrl} class="cta-btn" data-cta="ai-audit-hero-quiz">Κάνε το ερωτηματολόγιο</a>
            <a href="#process" class="text-link">Δες τη διαδικασία</a>
          </div>
          <dl class="hero-facts" aria-label="Βασικά στοιχεία υπηρεσίας">
            <div>
              <dt>Audit</dt>
              <dd>349€ + ΦΠΑ</dd>
            </div>
            <div>
              <dt>Εγγύηση</dt>
              <dd>3+ ευρήματα ή επιστροφή</dd>
            </div>
            <div>
              <dt>Στόχος</dt>
              <dd>ορατότητα + επικοινωνία</dd>
            </div>
          </dl>
        </div>

        <aside class="audit-mockup" aria-label="Δείγμα κάρτας βαθμολογίας AI Visibility">
          <div class="mockup-topbar">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="score-row">
            <div>
              <p class="mockup-label">Βαθμολογία ορατότητας AI</p>
              <strong>62/100</strong>
            </div>
            <p class="score-note">Ενδεικτικό δείγμα</p>
          </div>
          <div class="signal-list">
            <div class="signal good">
              <span></span>
              <p><strong>Καθαρή πρόταση</strong> που καταλαβαίνει ο επισκέπτης</p>
            </div>
            <div class="signal warn">
              <span></span>
              <p><strong>Στοιχεία επιχείρησης</strong> που δεν διαβάζονται καθαρά από τα AI</p>
            </div>
            <div class="signal bad">
              <span></span>
              <p><strong>Διαδρομή επικοινωνίας</strong> χωρίς καθαρό επόμενο βήμα</p>
            </div>
          </div>
          <div class="mockup-card">
            <p>Κύριο εύρημα</p>
            <strong>Άλλο βλέπει ο άνθρωπος, άλλο διαβάζει η μηχανή από πίσω.</strong>
          </div>
        </aside>
      </div>
    </section>

    <section class="answer-band">
      <div class="shell answer-grid">
        <div>
          <p class="eyebrow">Τι είναι</p>
          <h2>Το AI Visibility δεν είναι μαγικό. Είναι καθαρή πληροφορία που μπορεί να διαβαστεί σωστά.</h2>
        </div>
        <p>
          Πολλές επιχειρήσεις έχουν site που φαίνεται κανονικό σε άνθρωπο, αλλά η μηχανή από πίσω δεν καταλαβαίνει καθαρά ποιοι είναι, τι προσφέρουν, σε ποια αγορά δουλεύουν και γιατί να τους προτείνει.
        </p>
      </div>
    </section>

    <section class="proof-preview">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Δείγμα ελέγχου</p>
          <h2>Δεν πουλάμε υποσχέσεις. Δείχνουμε πού υπάρχει κενό.</h2>
          <p>Η αναφορά πρέπει να μοιάζει με εργαλείο απόφασης, όχι με γενική συμβουλή. Γι' αυτό το πρώτο παραδοτέο είναι μια καθαρή μέτρηση με ευρήματα, προτεραιότητες και επόμενο βήμα.</p>
        </div>
        <div class="scroll-stage" aria-label="Δείγμα ενοτήτων αναφοράς ελέγχου">
          <div class="report-sheet">
            <div class="report-header">
              <span>Πρώτη μέτρηση AI Visibility</span>
              <strong>Χάρτης ευρημάτων</strong>
            </div>
            <div class="report-grid">
              <article>
                <span>01</span>
                <h3>Τι ψάχνει ο πελάτης</h3>
                <p>Ποιες ερωτήσεις πρέπει να απαντά καθαρά η σελίδα.</p>
              </article>
              <article>
                <span>02</span>
                <h3>Τι διαβάζει η μηχανή</h3>
                <p>Τι λείπει από τίτλους, δομή, δομημένα δεδομένα και στοιχεία επιχείρησης.</p>
              </article>
              <article>
                <span>03</span>
                <h3>Αποδείξεις εμπιστοσύνης</h3>
                <p>Πού χρειάζεται απόδειξη χωρίς fake testimonials ή υπερβολές.</p>
              </article>
              <article>
                <span>04</span>
                <h3>Διαδρομή προς την επικοινωνία</h3>
                <p>Ποιο είναι το καθαρότερο επόμενο βήμα για τον σωστό πελάτη.</p>
              </article>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="process" class="process">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Διαδικασία</p>
          <h2>Από ερωτηματολόγιο σε καθαρή απόφαση</h2>
        </div>
        <ol class="steps">
          <li>
            <span>1</span>
            <h3>Ερωτηματολόγιο</h3>
            <p>Μαζεύουμε βασικά στοιχεία για επιχείρηση, πρόταση, αγορά και επείγοντα στόχο.</p>
          </li>
          <li>
            <span>2</span>
            <h3>Έλεγχος ορατότητας</h3>
            <p>Ελέγχουμε site, σήματα σε Google, ετοιμότητα για απαντήσεις AI και διαδρομή προς την επικοινωνία.</p>
          </li>
          <li>
            <span>3</span>
            <h3>Ευρήματα</h3>
            <p>Παραδίδουμε τουλάχιστον 3 χρήσιμα ευρήματα ή επιστροφή χρημάτων στον πληρωμένο έλεγχο.</p>
          </li>
          <li>
            <span>4</span>
            <h3>Πλάνο ενεργειών</h3>
            <p>Βάζουμε σειρά: τι αλλάζει πρώτο, τι περιμένει και τι αξίζει να υλοποιηθεί από εμάς.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="pricing">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Πακέτα</p>
          <h2>Ξεκινάμε με διάγνωση, όχι με τυφλή υλοποίηση</h2>
          <p>Το ερωτηματολόγιο δείχνει αν υπάρχει πραγματικός λόγος να προχωρήσουμε. Ο πληρωμένος έλεγχος δίνει την πρώτη μέτρηση. Η υλοποίηση έρχεται μόνο όταν έχει νόημα.</p>
        </div>
        <div class="pricing-grid">
          <article class="pricing-card featured">
            <p class="pricing-label">Πρώτη μέτρηση</p>
            <h3>AI Visibility Audit</h3>
            <p class="price">349€ <span>+ ΦΠΑ</span></p>
            <ul>
              <li>Έλεγχος site και πρότασης</li>
              <li>Έλεγχοι ορατότητας σε Google και AI</li>
              <li>Ευρήματα για τη διαδρομή προς την επικοινωνία</li>
              <li>3+ χρήσιμα ευρήματα ή επιστροφή χρημάτων</li>
            </ul>
            <a href={quizUrl} class="cta-btn" data-cta="ai-audit-pricing-audit">Ξεκίνα με το ερωτηματολόγιο</a>
          </article>
          <article class="pricing-card">
            <p class="pricing-label">Υλοποίηση</p>
            <h3>Visibility Sprint</h3>
            <p class="price">1.290€</p>
            <ul>
              <li>Διορθώσεις με σειρά προτεραιότητας</li>
              <li>Αναδιάρθρωση σελίδων και κειμένων</li>
              <li>Δομημένα δεδομένα, ερωτήσεις-απαντήσεις, κείμενα</li>
              <li>Επαλήθευση μετά τις αλλαγές</li>
            </ul>
            <p class="card-note">Μόνο αν ο έλεγχος δείξει καθαρό λόγο υλοποίησης.</p>
          </article>
          <article class="pricing-card">
            <p class="pricing-label">Συνεχής παρακολούθηση</p>
            <h3>AI Visibility Monitoring</h3>
            <p class="price">250€ <span>+ ΦΠΑ / μήνα</span></p>
            <ul>
              <li>Μηνιαίος έλεγχος ορατότητας</li>
              <li>Νέες ερωτήσεις που αξίζει να καλυφθούν</li>
              <li>Προτεραιότητες σε κείμενα και επικοινωνία</li>
              <li>Μηνιαία αναφορά</li>
            </ul>
            <p class="card-note">Για επιχειρήσεις που θέλουν συνεχή βελτίωση.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="boundaries">
      <div class="shell boundary-grid">
        <div>
          <p class="eyebrow">Όρια</p>
          <h2>Τι δεν υποσχόμαστε</h2>
        </div>
        <ul>
          <li>Δεν υπόσχομαι κατάταξη σε Google ή εργαλεία AI.</li>
          <li>Δεν υπόσχομαι έσοδα ή συγκεκριμένο αριθμό αιτημάτων επικοινωνίας.</li>
          <li>Δεν δίνω γενικές συμβουλές χωρίς στοιχεία από το δικό σου site.</li>
          <li>Δεν χρησιμοποιώ ψεύτικες κριτικές, ψεύτικα λογότυπα ή φουσκωμένους ισχυρισμούς.</li>
        </ul>
      </div>
    </section>

    <section class="faq">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Ερωτήσεις</p>
          <h2>Οι βασικές ερωτήσεις που πρέπει να απαντά το site</h2>
        </div>
        <div class="faq-list">
          {faqItems.map((item) => (
            <article class="faq-item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="shell final-panel">
        <p class="eyebrow">Πρώτο βήμα</p>
        <h2>Ξεκίνα με το ερωτηματολόγιο. Αν υπάρχει πραγματικό κενό ορατότητας, θα το δούμε πριν πληρώσεις έλεγχο.</h2>
        <a href={quizUrl} class="cta-btn" data-cta="ai-audit-final-quiz">Άνοιξε το ερωτηματολόγιο</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .audit-page {
    --ai-bg: #f8fafc;
    --ai-surface: #ffffff;
    --ai-ink: #0f172a;
    --ai-muted: #475569;
    --ai-soft: #e2e8f0;
    --ai-navy: #16324a;
    --ai-blue: #0f2436;
    --ai-gold: #0e7568;
    background:
      linear-gradient(180deg, rgba(14, 117, 104, 0.08), rgba(248, 250, 252, 0) 460px),
      var(--ai-bg);
    color: var(--ai-ink);
    overflow-x: hidden;
  }

  .shell {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  section {
    padding: 72px 0;
  }

  :global(.reveal-ready) .audit-page section {
    opacity: 1;
    transform: none;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--ai-gold);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    color: var(--ai-ink);
    font-family: var(--font-display);
    letter-spacing: 0;
  }

  h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2.35rem, 5vw, 4.8rem);
    line-height: 1.02;
  }

  h2 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(1.85rem, 3.4vw, 3rem);
    line-height: 1.08;
  }

  h3 {
    margin: 0;
    font-size: 1.12rem;
    line-height: 1.25;
  }

  p {
    color: var(--ai-muted);
    line-height: 1.7;
  }

  .hero {
    padding: 86px 0 72px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.72fr);
    gap: 48px;
    align-items: center;
  }

  .subtitle {
    max-width: 660px;
    margin: 24px 0 0;
    font-size: 1.13rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin-top: 32px;
  }

  .cta-btn,
  .text-link {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .cta-btn {
    background: var(--ai-gold);
    color: #fff;
    padding: 0 20px;
    border: 1px solid rgba(14, 117, 104, 0.24);
  }

  .cta-btn:hover,
  .text-link:hover {
    transform: translateY(-1px);
  }

  .text-link {
    color: var(--ai-navy);
    padding: 0 6px;
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    max-width: 720px;
    margin: 34px 0 0;
  }

  .hero-facts div {
    border: 1px solid rgba(14, 117, 104, 0.14);
    background: rgba(255, 255, 255, 0.72);
    border-radius: 8px;
    padding: 14px;
  }

  .hero-facts dt {
    color: var(--ai-muted);
    font-size: 0.78rem;
  }

  .hero-facts dd {
    margin: 4px 0 0;
    color: var(--ai-ink);
    font-weight: 700;
  }

  .audit-mockup {
    border: 1px solid rgba(15, 23, 42, 0.1);
    background: rgba(255, 255, 255, 0.86);
    border-radius: 8px;
    padding: 18px;
    box-shadow: 0 24px 70px rgba(15, 23, 42, 0.14);
  }

  .mockup-topbar {
    display: flex;
    gap: 7px;
    margin-bottom: 18px;
  }

  .mockup-topbar span {
    width: 9px;
    height: 9px;
    border-radius: 99px;
    background: #cbd5e1;
  }

  .score-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
    border: 1px solid rgba(14, 117, 104, 0.12);
    background: #f8fafc;
    border-radius: 8px;
    padding: 18px;
  }

  .mockup-label,
  .score-note,
  .mockup-card p {
    margin: 0;
    color: var(--ai-muted);
    font-size: 0.8rem;
  }

  .score-row strong {
    display: block;
    margin-top: 6px;
    color: var(--ai-navy);
    font-family: var(--font-display);
    font-size: 2.3rem;
    line-height: 1;
  }

  .signal-list {
    display: grid;
    gap: 10px;
    margin: 16px 0;
  }

  .signal {
    display: grid;
    grid-template-columns: 12px 1fr;
    gap: 12px;
    align-items: center;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 8px;
    padding: 12px;
  }

  .signal span {
    width: 10px;
    height: 10px;
    border-radius: 99px;
  }

  .signal.good span { background: #15803d; }
  .signal.warn span { background: #0e7568; }
  .signal.bad span { background: #b91c1c; }

  .signal p {
    margin: 0;
    font-size: 0.88rem;
  }

  .mockup-card {
    border-radius: 8px;
    background: #0f172a;
    padding: 16px;
  }

  .mockup-card strong {
    display: block;
    margin-top: 6px;
    color: #fff;
    line-height: 1.45;
  }

  .answer-band,
  .process,
  .boundaries {
    background: var(--ai-surface);
    border-top: 1px solid var(--ai-soft);
    border-bottom: 1px solid var(--ai-soft);
  }

  .answer-grid,
  .boundary-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 42px;
    align-items: start;
  }

  .answer-grid p,
  .boundary-grid ul {
    margin: 0;
    font-size: 1.05rem;
  }

  .section-heading {
    max-width: 780px;
    margin-bottom: 34px;
  }

  .section-heading p:last-child {
    margin-bottom: 0;
  }

  .scroll-stage {
    perspective: 1200px;
  }

  .report-sheet {
    border: 1px solid rgba(14, 117, 104, 0.14);
    background: linear-gradient(180deg, #fff, #f8fafc);
    border-radius: 8px;
    padding: 24px;
    box-shadow: 0 22px 70px rgba(15, 23, 42, 0.12);
    transform: rotateX(2deg);
    transform-origin: top center;
  }

  .report-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
