---
/**
 * Calculator.astro — «Πόσο σου κοστίζει το να περιμένεις;»
 *
 * Εκπαιδευτική προσομοίωση, όχι πρόβλεψη. Οι παραδοχές μένουν ορατές
 * και επεξεργάσιμες για compliance.
 */
import { AFFILIATES, GUIDES } from "../config";

const freedom24 = AFFILIATES.find((a) => a.name === "Freedom24");
const freedom24Pdf = GUIDES.freedom24Pdf;
---
<section id="calculator" class="section-shell scroll-mt-16">
  <div class="max-w-4xl mx-auto">
    <p class="eyebrow justify-center w-full">Ο υπολογισμός</p>
    <h2 class="mt-4 text-center section-title">Πόσο σου κοστίζει το να περιμένεις;</h2>
    <p class="mt-4 text-center section-copy max-w-2xl mx-auto">
      Τα χρήματα που κάθονται σε λογαριασμό δεν μένουν ίδια. Χάνουν αγοραστική δύναμη
      κάθε χρόνο. Δες τη διαφορά σε σημερινά ευρώ και άλλαξε τα νούμερα όπως σου ταιριάζει.
    </p>

    <div class="panel mt-10 rounded-[1.75rem] p-6 sm:p-8" data-calc>
      <div class="grid gap-5 sm:grid-cols-3">
        <div>
          <label for="calc-start" class="mb-2 block text-sm text-ink-300">Ποσό που έχεις τώρα</label>
          <div class="relative" data-burst="start">
            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-500">€</span>
            <input
              id="calc-start"
              data-field="start"
              type="number"
              min="0"
              step="100"
              value="0"
              inputmode="numeric"
              class="w-full rounded-xl border border-navy-600 bg-navy-950/60 pl-9 pr-4 py-3 text-ink-100 transition-colors focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/30"
            />
          </div>
        </div>

        <div>
          <label for="calc-monthly" class="mb-2 block text-sm text-ink-300">Κάθε μήνα βάζεις</label>
          <div class="relative" data-burst="monthly">
            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-500">€</span>
            <input
              id="calc-monthly"
              data-field="monthly"
              type="number"
              min="0"
              step="10"
              value="0"
              inputmode="numeric"
              class="w-full rounded-xl border border-navy-600 bg-navy-950/60 pl-9 pr-4 py-3 text-ink-100 transition-colors focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/30"
            />
          </div>
        </div>

        <div>
          <label for="calc-years" class="mb-2 block text-sm text-ink-300">Για πόσα χρόνια</label>
          <input
            id="calc-years"
            data-field="years"
            type="number"
            min="0"
            max="40"
            step="1"
            value="20"
            inputmode="numeric"
            class="w-full rounded-xl border border-navy-600 bg-navy-950/60 px-4 py-3 text-ink-100 transition-colors focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/30"
          />
        </div>
      </div>

      <details class="mt-5 rounded-xl border border-navy-700 bg-navy-950/40">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm text-ink-300">
          <span>Παραδοχές του υπολογισμού — άλλαξέ τις</span>
          <span class="text-gold-500" aria-hidden="true">+</span>
        </summary>
        <div class="grid gap-4 px-4 pb-4 sm:grid-cols-2">
          <div>
            <label for="calc-infl" class="mb-1.5 block text-xs text-ink-500">Μέσος πληθωρισμός (%/έτος)</label>
            <input
              id="calc-infl"
              data-field="infl"
              type="number"
              min="0"
              max="20"
              step="0.1"
              value="0"
              class="w-full rounded-lg border border-navy-600 bg-navy-950/60 px-3 py-2 text-sm text-ink-100 focus:border-gold-500 focus:outline-none"
            />
          </div>
          <div>
            <label for="calc-ret" class="mb-1.5 block text-xs text-ink-500">Υποθετική απόδοση (%/έτος)</label>
            <input
              id="calc-ret"
              data-field="ret"
              type="number"
              min="0"
              max="20"
              step="0.1"
              value="10.7"
              class="w-full rounded-lg border border-navy-600 bg-navy-950/60 px-3 py-2 text-sm text-ink-100 focus:border-gold-500 focus:outline-none"
            />
          </div>
          <p class="sm:col-span-2 text-xs leading-relaxed text-ink-500">
            Τα ποσοστά είναι <strong class="text-ink-300">παραδοχές για την προσομοίωση</strong>, όχι πρόβλεψη
            και όχι υπόσχεση απόδοσης. Καμία επένδυση δεν έχει σταθερή ετήσια απόδοση: η αξία ανεβαίνει
            και κατεβαίνει, και μπορείς να πάρεις πίσω λιγότερα από όσα έβαλες.
          </p>
        </div>
      </details>

      <div class="mt-7 grid gap-4 sm:grid-cols-2" aria-live="polite">
        <div class="metric-card p-5" data-emphasis="cash">
          <p class="mb-2 text-xs uppercase tracking-widest text-ink-500">Αν μείνουν στον λογαριασμό</p>
          <p class="font-display text-3xl text-ink-100" data-out="cashReal">€0</p>
          <p class="mt-1.5 text-xs text-ink-500">σε σημερινή αγοραστική δύναμη</p>
          <p class="mt-3 text-sm text-ink-300">
            Θα έχεις βάλει <span class="text-ink-100" data-out="cashNom">€0</span> — αλλά θα αγοράζουν
            λιγότερα απ' όσα σήμερα.
          </p>
        </div>

        <div class="panel-strong p-5" data-emphasis="result">
          <p class="mb-2 text-xs uppercase tracking-widest text-gold-500">Στο σενάριο της προσομοίωσης</p>
          <p class="font-display text-3xl text-gold-400" data-out="invReal">€0</p>
          <p class="mt-1.5 text-xs text-ink-500">σε σημερινή αγοραστική δύναμη</p>
          <p class="mt-3 text-sm text-ink-300">
            Διαφορά: <span class="font-semibold text-gold-400" data-out="diff">€0</span> —
            υποθετικό αποτέλεσμα, όχι εγγυημένο.
          </p>
        </div>
      </div>

      <div class="mt-5 grid gap-4 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
        <div class="rounded-[1.5rem] border border-navy-700 bg-navy-950/45 p-5">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs uppercase tracking-widest text-ink-500">Πίνακας αποτελέσματος</p>
              <h3 class="mt-2 font-display text-2xl text-ink-100">Τι δείχνει το σενάριο</h3>
            </div>
            <div class="rounded-full border border-gold-600/40 bg-gold-500/10 px-3 py-1 text-xs font-semibold text-gold-300">
              <span data-out="annualRate">10,7%</span> / έτος
            </div>
          </div>

          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            <div class="rounded-2xl border border-navy-700 bg-navy-900/70 p-4">
              <p class="text-xs uppercase tracking-widest text-ink-500">Τελική αξία</p>
              <p class="mt-2 font-display text-2xl text-ink-100" data-out="invNom">€0</p>
              <p class="mt-1 text-xs text-ink-500">ονομαστικά, πριν τον πληθωρισμό</p>
            </div>
            <div class="rounded-2xl border border-navy-700 bg-navy-900/70 p-4">
              <p class="text-xs uppercase tracking-widest text-ink-500">Συνολικά χρήματα που έβαλες</p>
              <p class="mt-2 font-display text-2xl text-ink-100" data-out="invested">€0</p>
              <p class="mt-1 text-xs text-ink-500">αρχικό ποσό + μηνιαίες καταβολές</p>
            </div>
            <div class="rounded-2xl border border-gold-600/30 bg-gold-500/8 p-4">
              <p class="text-xs uppercase tracking-widest text-gold-400/80">Κέρδος από απόδοση</p>
              <p class="mt-2 font-display text-2xl text-gold-300" data-out="gainNom">€0</p>
              <p class="mt-1 text-xs text-ink-500">υποθετικό κέρδος, όχι εγγυημένο</p>
            </div>
            <div class="rounded-2xl border border-navy-700 bg-navy-900/70 p-4">
              <p class="text-xs uppercase tracking-widest text-ink-500">Ορίζοντας</p>
              <p class="mt-2 font-display text-2xl text-ink-100"><span data-out="yearCount">0</span> έτη</p>
              <p class="mt-1 text-xs text-ink-500">με μηνιαίο compounding στη λογική του calculator.net</p>
            </div>
          </div>
        </div>

        <div class="rounded-[1.5rem] border border-gold-600/20 bg-gradient-to-br from-gold-500/12 via-navy-900/70 to-navy-950/80 p-5">
          <p class="text-xs uppercase tracking-widest text-gold-400/80">Γρήγορο διάβασμα</p>
          <h3 class="mt-2 font-display text-2xl text-ink-100">Η ετήσια απόδοση κάνει τη διαφορά</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-300">
            Ο πίνακας κάτω δείχνει για κάθε έτος πόσα έβαλες, πόσο από το τελικό ποσό
            ήρθε από απόδοση, και πού φτάνει η συνολική αξία. Είναι εργαλείο κατανόησης,
            όχι υπόσχεση για το μέλλον.
          </p>
          <div class="mt-5 rounded-2xl border border-navy-700 bg-navy-950/55 p-4">
            <p class="text-xs uppercase tracking-widest text-ink-500">Με τις τωρινές παραδοχές</p>
            <p class="mt-2 text-sm text-ink-300">
              Με <span class="font-semibold text-ink-100" data-out="investedInline">€0</span> συνολικά,
              το σενάριο φτάνει σε <span class="font-semibold text-gold-300" data-out="invNomInline">€0</span>.
            </p>
            <p class="mt-2 text-sm text-ink-300">
              Από αυτά, τα <span class="font-semibold text-gold-300" data-out="gainInline">€0</span>
              προέρχονται από την υποθετική απόδοση.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-5 overflow-hidden rounded-[1.5rem] border border-navy-700 bg-navy-950/45">
        <div class="flex items-center justify-between gap-3 border-b border-navy-700 px-5 py-4">
          <div>
            <p class="text-xs uppercase tracking-widest text-ink-500">Accumulation schedule</p>
            <h3 class="mt-1 font-display text-xl text-ink-100">Ετήσιος πίνακας απόδοσης</h3>
          </div>
          <p class="text-xs text-ink-500">Ενημερώνεται αυτόματα όταν αλλάζεις τα πεδία.</p>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-sm">
            <thead class="bg-navy-900/70 text-ink-300">
              <tr>
                <th class="px-4 py-3 font-medium">Έτος</th>
                <th class="px-4 py-3 font-medium">Συνολικές καταθέσεις</th>
                <th class="px-4 py-3 font-medium">Κέρδος από απόδοση</th>
                <th class="px-4 py-3 font-medium">Τελική αξία</th>
              </tr>
            </thead>
            <tbody data-table-body class="divide-y divide-navy-800 text-ink-100">
              <tr>
                <td colspan="4" class="px-4 py-4 text-center text-ink-500">Συμπλήρωσε τα πεδία για να δεις τον πίνακα.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div
        data-prompt
        class="mt-5 rounded-xl border border-gold-600/40 bg-gold-500/5 px-5 py-4 opacity-0 transition-opacity duration-500"
      >
        <p class="text-sm text-ink-100">
          <span aria-hidden="true">👆</span>
          <strong class="text-gold-400">Πειραματίσου.</strong>
          Βάλε το ποσό που θέλεις <em>εσύ</em> και δες τι αλλάζει — τα νούμερα ενημερώνονται αμέσως.
        </p>
      </div>

      <p class="mt-5 text-xs leading-relaxed text-ink-500">
        Εκπαιδευτική προσομοίωση με βάση τις παραδοχές που βλέπεις παραπάνω. Δεν αποτελεί επενδυτική,
        φορολογική ή νομική συμβουλή, ούτε πρόβλεψη. Δεν λαμβάνει υπόψη προμήθειες, φόρους ή προσωπικές
        συνθήκες. Οι επενδύσεις εμπεριέχουν ρίσκο — κάντε πάντα τη δική σας έρευνα.
      </p>
    </div>

    <div class="mt-8 grid gap-3 max-w-4xl mx-auto">
      <a
        href="/odigos-ependiseon"
        data-cta="calc-guide-page"
        class="inline-flex min-h-16 items-center justify-center rounded-full border border-[#31406D] bg-[#16244A] px-6 py-4 text-center font-display text-xl text-ink-100 transition-colors hover:border-[#3d4d82] hover:bg-[#1a2a57]"
      >
        Διάβασε τον οδηγό επενδύσεων →
      </a>

      {freedom24Pdf && (
        <a
          href={freedom24Pdf}
          target="_blank"
          rel="noopener"
          data-cta="calc-guide-pdf"
          class="inline-flex min-h-16 items-center justify-center rounded-full border border-gold-600 bg-[#16244A] px-6 py-4 text-center font-display text-xl text-ink-100 transition-colors hover:border-gold-400 hover:bg-[#1a2a57]"
        >
          📄 Κατέβασε τον οδηγό
        </a>
      )}

      {freedom24 && (
        <a
          href={freedom24.url}
          target="_blank"
          rel="noopener sponsored"
          data-cta="calc-open-account"
          class="inline-flex min-h-16 items-center justify-center rounded-full border border-gold-600 bg-[#16244A] px-6 py-4 text-center font-display text-xl text-ink-100 transition-colors hover:border-gold-400 hover:bg-[#1a2a57]"
        >
          Άνοιξε λογαριασμό Freedom24 📈
        </a>
      )}
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector("[data-calc]");
    if (!root) return;

    const f = (name) => root.querySelector(`[data-field="${name}"]`);
    const out = (name) => root.querySelector(`[data-out="${name}"]`);
    const prompt = root.querySelector("[data-prompt]");
    const tableBody = root.querySelector("[data-table-body]");
    const fields = {
      start: f("start"),
      monthly: f("monthly"),
      years: f("years"),
      infl: f("infl"),
      ret: f("ret"),
    };

    const eur = new Intl.NumberFormat("el-GR", {
      style: "currency",
      currency: "EUR",
      maximumFractionDigits: 0,
    });

    const setState = (value) => {
      root.dataset.calcState = value;
    };

    function compute() {
      const X = Math.max(0, +fields.start.value || 0);
      const M = Math.max(0, +fields.monthly.value || 0);
      const N = Math.min(40, Math.max(0, +fields.years.value || 0));
      const i = Math.max(0, (+fields.infl.value || 0) / 100);
      const r = Math.max(0, (+fields.ret.value || 0) / 100);

      const months = Math.round(N * 12);
      const im = i / 12;
      const rm = r / 12;

      const cashNom = X + M * months;
      let cashReal = N > 0 ? X / Math.pow(1 + i, N) : X;
      let invNom = X * Math.pow(1 + rm, months);

      for (let t = 1; t <= months; t++) {
        cashReal += M / Math.pow(1 + im, months - t + 1);
        invNom += M * Math.pow(1 + rm, months - t);
      }

      const invReal = N > 0 ? invNom / Math.pow(1 + i, N) : invNom;
      const gainNom = Math.max(0, invNom - cashNom);

      out("cashReal").textContent = eur.format(cashReal);
      out("cashNom").textContent = eur.format(cashNom);
      out("invReal").textContent = eur.format(invReal);
      out("diff").textContent = eur.format(Math.max(0, invReal - cashReal));
      out("invNom").textContent = eur.format(invNom);
      out("invested").textContent = eur.format(cashNom);
      out("gainNom").textContent = eur.format(gainNom);
      out("annualRate").textContent = `${(+fields.ret.value || 0).toLocaleString("el-GR", { minimumFractionDigits: 0, maximumFractionDigits: 1 })}%`;
      out("yearCount").textContent = String(N);
      out("investedInline").textContent = eur.format(cashNom);
      out("invNomInline").textContent = eur.format(invNom);
      out("gainInline").textContent = eur.format(gainNom);

      if (tableBody) {
        if (N === 0) {
          tableBody.innerHTML = '<tr><td colspan="4" class="px-4 py-4 text-center text-ink-500">Βάλε ορίζοντα πάνω από 0 έτη για να εμφανιστεί ο πίνακας.</td></tr>';
          return;
        }

        let balance = X;
        let totalDeposits = X;
        let rows = "";

        for (let year = 1; year <= N; year++) {
          const yearStart = balance;
          let annualDeposits = 0;

          for (let month = 0; month < 12; month++) {
            balance = balance * (1 + rm) + M;
            annualDeposits += M;
          }

          totalDeposits += annualDeposits;
          const totalGain = Math.max(0, balance - totalDeposits);
          rows += `
            <tr class="odd:bg-navy-950/20">
              <td class="px-4 py-3 font-semibold text-ink-100">${year}</td>
              <td class="px-4 py-3">${eur.format(totalDeposits)}</td>
              <td class="px-4 py-3 text-gold-300">${eur.format(totalGain)}</td>
              <td class="px-4 py-3">${eur.format(balance)}</td>
            </tr>
          `;

          if (yearStart === balance && annualDeposits === 0) break;
        }

        tableBody.innerHTML = rows;
      }
    }

    let userTookOver = false;
    const takeOver = () => {
      userTookOver = true;
      setState("manual");
      prompt.style.opacity = "1";
    };

    Object.values(fields).forEach((el) => {
      el.addEventListener("input", () => {
        takeOver();
        compute();
      });
      el.addEventListener("focus", takeOver);
    });

    const TARGET = { start: 3000, monthly: 150, years: 20 };
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const isMobile = window.matchMedia("(max-width: 767px)").matches;

    function fillInstantly() {
      setState("settled");
      fields.start.value = TARGET.start;
      fields.monthly.value = TARGET.monthly;
      fields.years.value = TARGET.years;
      compute();
      prompt.style.opacity = "1";
    }

    function animate() {
      const DURATION = 1100;
      const t0 = performance.now();
      const ease = (p) => 1 - Math.pow(1 - p, 3);
      let hitStateApplied = false;

      setState("animating");

      function frame(now) {
        if (userTookOver) return;
        const p = Math.min(1, (now - t0) / DURATION);
        const e = ease(p);
        fields.start.value = Math.round((TARGET.start * e) / 50) * 50;
        fields.monthly.value = Math.round((TARGET.monthly * e) / 10) * 10;
        fields.years.value = Math.round(TARGET.years * e);
        compute();

        if (!hitStateApplied && p >= 0.84) {
          hitStateApplied = true;
          setState("hit");
        }

        if (p < 1) requestAnimationFrame(frame);
        else {
          setState("settled");
          prompt.style.opacity = "1";
        }
      }

      requestAnimationFrame(frame);
    }

    if (isMobile) {
      // On mobile we skip the scroll-triggered animation so the target values
      // are visible immediately on first load.
      fillInstantly();
      return;
    }

    let started = false;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting || started) return;
        started = true;
        io.disconnect();
        if (reduce || userTookOver) fillInstantly();
        else animate();
      });
    }, { threshold: 0.35 });

    io.observe(root);
  })();
</script>

<style>
  [data-calc] [data-burst],
  [data-calc] [data-emphasis] {
    position: relative;
    isolation: isolate;
  }

  [data-calc][data-calc-state="animating"] [data-burst]::before,
  [data-calc][data-calc-state="hit"] [data-burst]::before {
    content: "";
    position: absolute;
    inset: -0.35rem;
    border-radius: 1.05rem;
    background:
      radial-gradient(circle at 20% 20%, rgba(232, 200, 121, 0.24), transparent 45%),
      radial-gradient(circle at 80% 20%, rgba(232, 200, 121, 0.12), transparent 36%),
      linear-gradient(120deg, rgba(232, 200, 121, 0.12), rgba(232, 200, 121, 0.02) 45%, rgba(232, 200, 121, 0.14));
    box-shadow:
      0 0 0 1px rgba(232, 200, 121, 0.12) inset,
      0 0 26px rgba(232, 200, 121, 0.14);
    opacity: 0;
    pointer-events: none;
    z-index: -1;
  }

  [data-calc][data-calc-state="animating"] [data-burst]::before {
    animation: calc-burst 1.15s ease-out both;
  }

  [data-calc][data-calc-state="hit"] [data-burst]::before {
    opacity: 1;
    animation: calc-hit 1.2s ease-out both;
  }

  [data-calc][data-calc-state="hit"] [data-burst]::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(110deg, transparent 0%, rgba(255, 245, 210, 0.36) 48%, transparent 58%);
    transform: translateX(-120%);
    pointer-events: none;
    z-index: -1;
    animation: calc-sweep 1.25s ease-out both;
  }

  [data-calc][data-calc-state="hit"] [data-emphasis] {
    animation: calc-pop 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  [data-calc][data-calc-state="hit"] [data-out="invNom"],
  [data-calc][data-calc-state="hit"] [data-out="gainNom"],
  [data-calc][data-calc-state="hit"] [data-out="invested"],
  [data-calc][data-calc-state="hit"] [data-out="invReal"] {
    text-shadow:
      0 0 18px rgba(232, 200, 121, 0.24),
      0 0 2px rgba(255, 255, 255, 0.14);
    animation: calc-pop 760ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes calc-burst {
    0% { opacity: 0; transform: scale(0.96); }
    25% { opacity: 1; }
    100% { opacity: 0; transform: scale(1.03); }
  }

  @keyframes calc-hit {
    0% { opacity: 0; transform: scale(0.98); }
