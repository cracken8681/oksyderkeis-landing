---
/**
 * Calculator.astro — «Πόσο σου κοστίζει το να περιμένεις;»
 *
 * Εκπαιδευτική προσομοίωση, όχι πρόβλεψη. Οι παραδοχές μένουν ορατές
 * και επεξεργάσιμες για compliance.
 */
---
<section id="calculator" class="section-shell scroll-mt-16">
  <div class="max-w-4xl mx-auto">
    <p class="eyebrow justify-center w-full">Ο υπολογισμός</p>
    <h2 class="mt-4 text-center section-title">Πόσο σου κοστίζει το να περιμένεις;</h2>
    <p class="mt-4 text-center section-copy max-w-2xl mx-auto">
      Τα χρήματα που κάθονται σε λογαριασμό δεν μένουν ίδια. Χάνουν αγοραστική δύναμη
      κάθε χρόνο. Δες τη διαφορά σε σημερινά ευρώ και άλλαξε τα νούμερα όπως σου ταιριάζει.
    </p>

    <div class="panel mt-10 rounded-[1.75rem] p-6 sm:p-8" data-calc>
      <div class="grid gap-5 sm:grid-cols-3">
        <div>
          <label for="calc-start" class="mb-2 block text-sm text-ink-300">Ποσό που έχεις τώρα</label>
          <div class="relative">
            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-500">€</span>
            <input
              id="calc-start"
              data-field="start"
              type="number"
              min="0"
              step="100"
              value="0"
              inputmode="numeric"
              class="w-full rounded-xl border border-navy-600 bg-navy-950/60 pl-9 pr-4 py-3 text-ink-100 transition-colors focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/30"
            />
          </div>
        </div>

        <div>
          <label for="calc-monthly" class="mb-2 block text-sm text-ink-300">Κάθε μήνα βάζεις</label>
          <div class="relative">
            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-500">€</span>
            <input
              id="calc-monthly"
              data-field="monthly"
              type="number"
              min="0"
              step="10"
              value="0"
              inputmode="numeric"
              class="w-full rounded-xl border border-navy-600 bg-navy-950/60 pl-9 pr-4 py-3 text-ink-100 transition-colors focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/30"
            />
          </div>
        </div>

        <div>
          <label for="calc-years" class="mb-2 block text-sm text-ink-300">Για πόσα χρόνια</label>
          <input
            id="calc-years"
            data-field="years"
            type="number"
            min="0"
            max="40"
            step="1"
            value="0"
            inputmode="numeric"
            class="w-full rounded-xl border border-navy-600 bg-navy-950/60 px-4 py-3 text-ink-100 transition-colors focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/30"
          />
        </div>
      </div>

      <details class="mt-5 rounded-xl border border-navy-700 bg-navy-950/40">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm text-ink-300">
          <span>Παραδοχές του υπολογισμού — άλλαξέ τις</span>
          <span class="text-gold-500" aria-hidden="true">+</span>
        </summary>
        <div class="grid gap-4 px-4 pb-4 sm:grid-cols-2">
          <div>
            <label for="calc-infl" class="mb-1.5 block text-xs text-ink-500">Μέσος πληθωρισμός (%/έτος)</label>
            <input
              id="calc-infl"
              data-field="infl"
              type="number"
              min="0"
              max="20"
              step="0.1"
              value="2.5"
              class="w-full rounded-lg border border-navy-600 bg-navy-950/60 px-3 py-2 text-sm text-ink-100 focus:border-gold-500 focus:outline-none"
            />
          </div>
          <div>
            <label for="calc-ret" class="mb-1.5 block text-xs text-ink-500">Υποθετική απόδοση (%/έτος)</label>
            <input
              id="calc-ret"
              data-field="ret"
              type="number"
              min="0"
              max="20"
              step="0.1"
              value="5"
              class="w-full rounded-lg border border-navy-600 bg-navy-950/60 px-3 py-2 text-sm text-ink-100 focus:border-gold-500 focus:outline-none"
            />
          </div>
          <p class="sm:col-span-2 text-xs leading-relaxed text-ink-500">
            Τα ποσοστά είναι <strong class="text-ink-300">παραδοχές για την προσομοίωση</strong>, όχι πρόβλεψη
            και όχι υπόσχεση απόδοσης. Καμία επένδυση δεν έχει σταθερή ετήσια απόδοση: η αξία ανεβαίνει
            και κατεβαίνει, και μπορείς να πάρεις πίσω λιγότερα από όσα έβαλες.
          </p>
        </div>
      </details>

      <div class="mt-7 grid gap-4 sm:grid-cols-2" aria-live="polite">
        <div class="metric-card p-5">
          <p class="mb-2 text-xs uppercase tracking-widest text-ink-500">Αν μείνουν στον λογαριασμό</p>
          <p class="font-display text-3xl text-ink-100" data-out="cashReal">€0</p>
          <p class="mt-1.5 text-xs text-ink-500">σε σημερινή αγοραστική δύναμη</p>
          <p class="mt-3 text-sm text-ink-300">
            Θα έχεις βάλει <span class="text-ink-100" data-out="cashNom">€0</span> — αλλά θα αγοράζουν
            λιγότερα απ' όσα σήμερα.
          </p>
        </div>

        <div class="panel-strong p-5">
          <p class="mb-2 text-xs uppercase tracking-widest text-gold-500">Στο σενάριο της προσομοίωσης</p>
          <p class="font-display text-3xl text-gold-400" data-out="invReal">€0</p>
          <p class="mt-1.5 text-xs text-ink-500">σε σημερινή αγοραστική δύναμη</p>
          <p class="mt-3 text-sm text-ink-300">
            Διαφορά: <span class="font-semibold text-gold-400" data-out="diff">€0</span> —
            υποθετικό αποτέλεσμα, όχι εγγυημένο.
          </p>
        </div>
      </div>

      <div
        data-prompt
        class="mt-5 rounded-xl border border-gold-600/40 bg-gold-500/5 px-5 py-4 opacity-0 transition-opacity duration-500"
      >
        <p class="text-sm text-ink-100">
          <span aria-hidden="true">👆</span>
          <strong class="text-gold-400">Πειραματίσου.</strong>
          Βάλε το ποσό που θέλεις <em>εσύ</em> και δες τι αλλάζει — τα νούμερα ενημερώνονται αμέσως.
        </p>
      </div>

      <p class="mt-5 text-xs leading-relaxed text-ink-500">
        Εκπαιδευτική προσομοίωση με βάση τις παραδοχές που βλέπεις παραπάνω. Δεν αποτελεί επενδυτική,
        φορολογική ή νομική συμβουλή, ούτε πρόβλεψη. Δεν λαμβάνει υπόψη προμήθειες, φόρους ή προσωπικές
        συνθήκες. Οι επενδύσεις εμπεριέχουν ρίσκο — κάντε πάντα τη δική σας έρευνα.
      </p>
    </div>

    <div class="mt-8 text-center">
      <a
        href="#mini-agent"
        data-cta="calc-to-agent"
        class="inline-flex items-center justify-center rounded-full bg-gold-500 px-7 py-3.5 font-semibold text-navy-950 transition-colors hover:bg-gold-400"
      >
        Δες πού στέκεσαι — δωρεάν βοηθός
      </a>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector("[data-calc]");
    if (!root) return;

    const f = (name) => root.querySelector(`[data-field="${name}"]`);
    const out = (name) => root.querySelector(`[data-out="${name}"]`);
    const prompt = root.querySelector("[data-prompt]");
    const fields = {
      start: f("start"),
      monthly: f("monthly"),
      years: f("years"),
      infl: f("infl"),
      ret: f("ret"),
    };

    const eur = new Intl.NumberFormat("el-GR", {
      style: "currency",
      currency: "EUR",
      maximumFractionDigits: 0,
    });

    function compute() {
      const X = Math.max(0, +fields.start.value || 0);
      const M = Math.max(0, +fields.monthly.value || 0);
      const N = Math.min(40, Math.max(0, +fields.years.value || 0));
      const i = Math.max(0, (+fields.infl.value || 0) / 100);
      const r = Math.max(0, (+fields.ret.value || 0) / 100);

      const months = Math.round(N * 12);
      const im = Math.pow(1 + i, 1 / 12) - 1;
      const rm = Math.pow(1 + r, 1 / 12) - 1;

      const cashNom = X + M * months;
      let cashReal = N > 0 ? X / Math.pow(1 + i, N) : X;
      let invNom = X * Math.pow(1 + rm, months);

      for (let t = 1; t <= months; t++) {
        cashReal += M / Math.pow(1 + im, months - t + 1);
        invNom += M * Math.pow(1 + rm, months - t);
      }

      const invReal = N > 0 ? invNom / Math.pow(1 + i, N) : invNom;

      out("cashReal").textContent = eur.format(cashReal);
      out("cashNom").textContent = eur.format(cashNom);
      out("invReal").textContent = eur.format(invReal);
      out("diff").textContent = eur.format(Math.max(0, invReal - cashReal));
    }

    let userTookOver = false;
    const takeOver = () => {
      userTookOver = true;
      prompt.style.opacity = "1";
    };

    Object.values(fields).forEach((el) => {
      el.addEventListener("input", () => {
        takeOver();
        compute();
      });
      el.addEventListener("focus", takeOver);
    });

    const TARGET = { start: 3000, monthly: 150, years: 10 };
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function fillInstantly() {
      fields.start.value = TARGET.start;
      fields.monthly.value = TARGET.monthly;
      fields.years.value = TARGET.years;
      compute();
      prompt.style.opacity = "1";
    }

    function animate() {
      const DURATION = 1100;
      const t0 = performance.now();
      const ease = (p) => 1 - Math.pow(1 - p, 3);

      function frame(now) {
        if (userTookOver) return;
        const p = Math.min(1, (now - t0) / DURATION);
        const e = ease(p);
        fields.start.value = Math.round((TARGET.start * e) / 50) * 50;
        fields.monthly.value = Math.round((TARGET.monthly * e) / 10) * 10;
        fields.years.value = Math.round(TARGET.years * e);
        compute();

        if (p < 1) requestAnimationFrame(frame);
        else prompt.style.opacity = "1";
      }

      requestAnimationFrame(frame);
    }

    let started = false;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting || started) return;
        started = true;
        io.disconnect();
        if (reduce || userTookOver) fillInstantly();
        else animate();
      });
    }, { threshold: 0.35 });

    io.observe(root);
  })();
</script>
