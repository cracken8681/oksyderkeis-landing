{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "oksyderkeis.vercel.app",
    "oksyderkeis.com",
    "www.oksyderkeis.com",
    "oksyderkeis.net",
    "www.oksyderkeis.net"
  ],
  "redirects": [
    {
      "source": "/ai-revenue",
      "has": [{ "type": "host", "value": "oksyderkeis.net" }],
      "destination": "https://ai-revenue-intake.vercel.app",
      "permanent": false
    },
    {
      "source": "/ai-revenue",
      "has": [{ "type": "host", "value": "www.oksyderkeis.net" }],
      "destination": "https://ai-revenue-intake.vercel.app",
      "permanent": false
    },
    {
      "source": "/ai-revenue/:path*",
      "has": [{ "type": "host", "value": "oksyderkeis.net" }],
      "destination": "https://ai-revenue-intake.vercel.app",
      "permanent": false
    },
    {
      "source": "/ai-revenue/:path*",
      "has": [{ "type": "host", "value": "www.oksyderkeis.net" }],
      "destination": "https://ai-revenue-intake.vercel.app",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
